{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"packages/*/src/index.ts",
		"packages/*/src/core/index.ts",
		"packages/json-editor/src/codemirror.tsx",
		"demo/main.tsx",
		"scripts/*.mjs",
		"packages/*/tests/build-probe.ts",
		"packages/*/tests/**/*.test.{ts,tsx}",
		"tests/setup/*"
	],
	"project": [
		"packages/*/src/**",
		"packages/*/demo/**",
		"demo/**",
		"scripts/**",
		"packages/*/tests/**",
		"tests/setup/**"
	]
}
