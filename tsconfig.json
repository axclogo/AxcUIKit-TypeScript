{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node", "react", "react-dom"],
		"paths": {
			"@axclogo/uikit/condition": ["./packages/condition/src/index.ts"],
			"@axclogo/uikit/code-editor": ["./packages/code-editor/src/index.ts"],
			"@axclogo/uikit/json-editor/codemirror": ["./packages/json-editor/src/codemirror.tsx"]
		}
	},
	"include": ["packages/*/src", "packages/*/tests", "packages/*/demo", "demo", "tests/setup"]
}
