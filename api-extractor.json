{
	"$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
	"mainEntryPointFilePath": "<projectFolder>/dist/types/condition/src/index.d.ts",
	"apiReport": {
		"enabled": true
	},
	"docModel": {
		"enabled": false
	},
	"dtsRollup": {
		"enabled": false
	},
	"tsdocMetadata": {
		"enabled": false
	},
	"messages": {
		"extractorMessageReporting": {
			"default": {
				"logLevel": "warning"
			},
			"ae-missing-release-tag": {
				"logLevel": "none"
			},
			"ae-forgotten-export": {
				"logLevel": "error"
			}
		},
		"tsdocMessageReporting": {
			"default": {
				"logLevel": "none"
			}
		}
	}
}
